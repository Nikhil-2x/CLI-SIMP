semgrep --config=auto --json --quiet . | jq '.results|length'
gitleaks detect --source . --no-git --exit-code 0 -f json -r /tmp/gl.json; jq length /tmp/gl.json
osv-scanner --format json -r . | jq '[.results[].packages[].vulnerabilities[]]|length'
bandit -r . -f json -q -x ./node_modules | jq '.results|length'

